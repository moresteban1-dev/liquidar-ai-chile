{
  "buildCommand": "cd 01-Agente-Dropservice/dropservice-platform && npm ci",
  "outputDirectory": "01-Agente-Dropservice/dropservice-platform/.next",
  "framework": "nextjs",
  "installCommand": "npm ci",
  
  "build": {
    "env": {
      "NEXT_TELEMETRY_DISABLED": "1",
      "NODE_OPTIONS": "--max-old-space-size=4096",
      "SKIP_ENV_VALIDATION": "true"
    }
  },
  
  "functions": {
    "01-Agente-Dropservice/dropservice-platform/src/app/api/**/*": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  
  "regions": ["iad1"]
}