{
  "buildCommand": "next build --webpack",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm ci",
  
  "build": {
    "env": {
      "NEXT_TELEMETRY_DISABLED": "1",
      "NODE_OPTIONS": "--max-old-space-size=4096",
      "SKIP_ENV_VALIDATION": "true"
    }
  },
  
  "functions": {
    "src/app/api/**/*": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  
  "regions": ["iad1"]
}